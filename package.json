{
  "name": "@alexify/migronaut",
  "version": "1.0.0",
  "description": "Elegant, fast, TypeScript-first MongoDB migrations for Node.js",
  "license": "MIT",
  "author": "Alex Dolid <dolid.sasha@gmail.com>",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Alexis-Technologies/migronaut.git"
  },
  "homepage": "https://migronaut.vercel.app/",
  "bugs": {
    "url": "https://github.com/Alexis-Technologies/migronaut/issues"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "packageManager": "pnpm@10.34.5",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "bin": {
    "migronaut": "dist/migronaut.cjs"
  },
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.cjs"
      }
    }
  },
  "files": [
    "dist",
    "README.md",
    "CHANGELOG.md"
  ],
  "scripts": {
    "build": "tsup",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "coverage": "vitest run --coverage",
    "lint": "oxlint src bin tests",
    "format": "oxfmt src bin tests",
    "format:check": "oxfmt --check src bin tests",
    "docs:dev": "vitepress dev docs",
    "docs:build": "vitepress build docs",
    "docs:preview": "vitepress preview docs",
    "prepublishOnly": "pnpm run typecheck && pnpm run lint && pnpm run format:check && pnpm run test && pnpm run build",
    "release": "pnpm publish"
  },
  "keywords": [
    "mongodb",
    "mongo",
    "migration",
    "migrations",
    "mongodb-migration",
    "mongodb-migrations",
    "database-migration",
    "schema-migration",
    "migrate-mongo",
    "mongoose",
    "mongoose-migration",
    "rollback",
    "transactions",
    "cli",
    "typescript",
    "nosql"
  ],
  "dependencies": {
    "chalk": "^4.1.2",
    "cli-table3": "^0.6.5",
    "commander": "^12.1.0",
    "dotenv": "^16.4.5",
    "ora": "^5.4.1",
    "zod": "^3.23.8"
  },
  "peerDependencies": {
    "mongodb": ">=5.0.0",
    "mongoose": ">=7.0.0"
  },
  "peerDependenciesMeta": {
    "mongoose": {
      "optional": true
    }
  },
  "devDependencies": {
    "@types/node": "^22.19.19",
    "@vitest/coverage-v8": "^4.1.8",
    "mongodb": "^6.12.0",
    "mongodb-memory-server": "^10.1.2",
    "mongoose": "^8.9.2",
    "oxfmt": "^0.60.0",
    "oxlint": "^1.75.0",
    "tsup": "^8.3.5",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "vite": "^8.1.5",
    "vitepress": "^1.6.4",
    "vitest": "^4.1.8"
  }
}
