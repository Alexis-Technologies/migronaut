# migronaut reads these itself (MIGRONAUT_* env layer)
MIGRONAUT_URI=mongodb://127.0.0.1:27017/?directConnection=true
MIGRONAUT_DB=migration_service_example
# Against a plain MongoDB (no Atlas Search), converge everything but the search index:
# MIGRONAUT_ON_SEARCH_UNAVAILABLE=skip

# Read by the example
REDIS_URL=redis://127.0.0.1:6379
PORT=3000
# Loopback by default — the API has no authentication. 0.0.0.0 only behind
# something that authenticates (a gateway, a network policy).
HOST=127.0.0.1
# api    — HTTP only (enqueue, status)
# worker — applies the jobs
# all    — both in one process
ROLE=all

# Tracing is off until this is set. `docker compose up -d` starts a Jaeger that
# listens here; its UI is http://127.0.0.1:16686
# OTEL_EXPORTER_OTLP_ENDPOINT=http://127.0.0.1:4318
